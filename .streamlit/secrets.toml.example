# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and populate with genuine credentials.
# NEVER commit .streamlit/secrets.toml or .env to version control!

# ==========================================
# 1. Google OAuth 2.0 / Streamlit Native Auth
# ==========================================
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace_with_a_secure_random_32_byte_secret_key"

[auth.google]
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Backward compatibility / flat keys (optional):
GOOGLE_CLIENT_ID = "your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-google-client-secret"

# ==========================================
# 2. Gmail SMTP for Email OTP Verification
# ==========================================
# Use a 16-character Google App Password (not your account password)
# Requirements: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER = "your-address@gmail.com"
SMTP_APP_PASSWORD = "abcd efgh ijkl mnop"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 465

# ==========================================
# 3. Twilio SMS / Phone Verification
# ==========================================
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your_twilio_auth_token"
TWILIO_PHONE_NUMBER = "+1234567890"

# Optional: Twilio Verify Service SID (if using Twilio Verify API instead of raw SMS)
TWILIO_VERIFY_SERVICE_SID = "VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# 4. ReviewLens Application Settings
# ==========================================
# Set to "1" to enable fallback demo sandboxes when credentials are absent.
# In production, leave "0" so unconfigured services show honest disabled status.
REVIEWLENS_DEMO_MODE = "0"

# Optional: Public PWA / Web installation URL for sidebar and download prompts
REVIEWLENS_INSTALL_URL = "https://vinayvardhan224.github.io/Reviewlens"
